[{"type": "SentenceBoundary", "offset": 1000000, "duration": 59750000, "text": "Bu tür etkinlikler nadiren iletişim kuran gruplar arasındaki güveni güçlendirebilir."}, {"type": "SentenceBoundary", "offset": 60250000, "duration": 34750000, "text": "Ana yargı güvenin güçlenebileceğidir."}, {"type": "SentenceBoundary", "offset": 95000000, "duration": 51375000, "text": "Yan cümle grupları tanımlar: nadiren iletişim kuran gruplar."}, {"type": "SentenceBoundary", "offset": 146375000, "duration": 33625000, "text": "Kesin sonuç değil olasılık anlatılıyor."}]