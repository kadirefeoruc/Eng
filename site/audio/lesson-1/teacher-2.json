[{"type": "SentenceBoundary", "offset": 1000000, "duration": 79500000, "text": "Ancak bugün kütüphaneler internet erişimi, çalışma alanları, dil kursları ve iş arayanlara destek de sağlar."}, {"type": "SentenceBoundary", "offset": 80000000, "duration": 37625000, "text": "Kütüphaneler özne, sağlar yüklemdir."}, {"type": "SentenceBoundary", "offset": 117625000, "duration": 29875000, "text": "Sunulan hizmetler nesnedir."}, {"type": "SentenceBoundary", "offset": 147500000, "duration": 44875000, "text": "Ancak ifadesi eski ve yeni işlevi karşılaştırır."}, {"type": "SentenceBoundary", "offset": 192375000, "duration": 35625000, "text": "İş arayan ifadesi insanları niteler."}]