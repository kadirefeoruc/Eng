[{"type": "SentenceBoundary", "offset": 1000000, "duration": 62500000, "text": "Bir kütüphaneye ulaşmak zorsa en çok yararlanabilecek kişiler onu kullanamayabilir."}, {"type": "SentenceBoundary", "offset": 63000000, "duration": 35625000, "text": "Başta koşul vardır: ulaşım zorluğu."}, {"type": "SentenceBoundary", "offset": 98625000, "duration": 39500000, "text": "Ana özne en çok yararlanabilecek kişilerdir."}, {"type": "SentenceBoundary", "offset": 138125000, "duration": 38500000, "text": "Sonuç, kütüphaneyi kullanamama olasılığıdır."}]