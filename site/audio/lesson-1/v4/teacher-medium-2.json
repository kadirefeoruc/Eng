[{"type": "SentenceBoundary", "offset": 1000000, "duration": 65000000, "text": "Belediye hemen daha fazla ekipman almak yerine kent sakinlerine günlük düzenlerini sordu."}, {"type": "SentenceBoundary", "offset": 65500000, "duration": 38125000, "text": "Başlangıç bölümü seçilmeyen eylemi anlatır."}, {"type": "SentenceBoundary", "offset": 103625000, "duration": 47625000, "text": "Ana cümle yapılan eylemdir: kent sakinlerine soru sormak."}, {"type": "SentenceBoundary", "offset": 151250000, "duration": 38250000, "text": "Yerine ifadesinden sonra fiil isimleşir."}]