[{"type": "SentenceBoundary", "offset": 1000000, "duration": 62375000, "text": "Maya bir üniversite öğrencisidir ve haftada iki kez mahallesindeki kütüphaneye gider."}, {"type": "SentenceBoundary", "offset": 62875000, "duration": 27875000, "text": "İlk cümle Maya'yı tanıtır."}, {"type": "SentenceBoundary", "offset": 90750000, "duration": 44125000, "text": "İkinci cümlenin öznesi onu temsil eden o zamiridir."}, {"type": "SentenceBoundary", "offset": 134875000, "duration": 32250000, "text": "Ve bağlacı iki bilgiyi birleştirir."}, {"type": "SentenceBoundary", "offset": 167125000, "duration": 37250000, "text": "Haftada iki kez ifadesi sıklığı gösterir."}]