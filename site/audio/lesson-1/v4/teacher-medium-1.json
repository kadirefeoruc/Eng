[{"type": "SentenceBoundary", "offset": 1000000, "duration": 71500000, "text": "Binada yararlı kitaplar ve ücretsiz bilgisayarlar bulunmasına rağmen ziyaretçi sayısı düşük kaldı."}, {"type": "SentenceBoundary", "offset": 72000000, "duration": 30875000, "text": "İlk bölüm olumlu olanakları verir."}, {"type": "SentenceBoundary", "offset": 102875000, "duration": 53000000, "text": "Ana bölüm beklenmeyen sonucu anlatır: ziyaretçi sayısı düşüktür."}, {"type": "SentenceBoundary", "offset": 155875000, "duration": 36875000, "text": "Rağmen anlamındaki bağlaç karşıtlık kurar."}]