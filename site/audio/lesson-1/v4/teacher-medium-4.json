[{"type": "SentenceBoundary", "offset": 1000000, "duration": 61625000, "text": "Birçok yetişkin gündüz çalışırken bazı ebeveynler çocukları olmadan gelemiyordu."}, {"type": "SentenceBoundary", "offset": 62125000, "duration": 37750000, "text": "İki grubun farklı kısıtları karşılaştırılır."}, {"type": "SentenceBoundary", "offset": 99875000, "duration": 54250000, "text": "Birinci grup gündüz çalışır, ikinci grup çocukları olmadan gelemez."}, {"type": "SentenceBoundary", "offset": 154125000, "duration": 35250000, "text": "Bağlaç iki paralel durumu birleştirir."}]