[{"type": "SentenceBoundary", "offset": 1000000, "duration": 63000000, "text": "Açılış saatleri, ulaşım bağlantıları ve erişilebilir tesisler de dikkate alınmalıdır."}, {"type": "SentenceBoundary", "offset": 63500000, "duration": 32625000, "text": "Üç unsur ortak özneyi oluşturur."}, {"type": "SentenceBoundary", "offset": 96125000, "duration": 48500000, "text": "Dikkate alınmalıdır ifadesi zorunluluk bildiren edilgen yapıdır."}, {"type": "SentenceBoundary", "offset": 144625000, "duration": 34000000, "text": "Eylemi kimin yapacağı belirtilmez."}]