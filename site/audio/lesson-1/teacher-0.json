[{"type": "SentenceBoundary", "offset": 1000000, "duration": 51250000, "text": "Halk kütüphaneleri son birkaç on yılda önemli ölçüde değişmiştir."}, {"type": "SentenceBoundary", "offset": 51750000, "duration": 27125000, "text": "Özne halk kütüphaneleri."}, {"type": "SentenceBoundary", "offset": 78875000, "duration": 25125000, "text": "Yüklem değişmiştir."}, {"type": "SentenceBoundary", "offset": 104000000, "duration": 48250000, "text": "Geçmişte başlayıp bugüne etkisi süren değişim anlatılıyor."}, {"type": "SentenceBoundary", "offset": 152250000, "duration": 37125000, "text": "Son birkaç on yıl zaman ifadesidir."}]